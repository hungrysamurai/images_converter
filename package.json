{
  "name": "image_converter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0",
    "npm": "please-use-pnpm"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:convert-it.ru": "cross-env VITE_TARGET_DOMAIN=convert-it.ru vite build --outDir convert-it.ru --base=./",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext js,jsx,ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format:fix": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "analyze": "analyze --analyzerPort 5175",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "node -e \"if(process.env.npm_execpath.indexOf('pnpm') === -1) { console.error('\\n\\x1b[31m✖ Please use pnpm to install dependencies\\x1b[0m\\n'); process.exit(1); }\""
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^13.4.4",
    "gif.js": "^0.2.0",
    "gifuct-js": "^2.1.2",
    "jszip": "^3.10.2",
    "jszip-utils": "^0.1.0",
    "libheif-js": "^1.23.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "redux-persist": "^6.0.0",
    "styled-components": "^6.5.3",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/utif": "^3.0.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "only-allow": "^1.2.2",
    "prettier": "^3.9.9",
    "react-metrika": "^1.2.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-bundle-analyzer": "^1.3.9"
  },
  "overrides": {
    "eslint": "9.27.0"
  }
}
