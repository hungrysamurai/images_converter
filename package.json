{
  "name": "image_converter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0",
    "npm": "please-use-pnpm"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:convert-it.ru": "cross-env VITE_TARGET_DOMAIN=convert-it.ru vite build --outDir convert-it.ru --base=./",
    "lint": "eslint src --ext js,jsx,ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format:fix": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "analyze": "analyze --analyzerPort 5175",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "node -e \"if(process.env.npm_execpath.indexOf('pnpm') === -1) { console.error('\\n\\x1b[31m✖ Please use pnpm to install dependencies\\x1b[0m\\n'); process.exit(1); }\""
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.43.0",
    "gif.js": "^0.2.0",
    "gifuct-js": "^2.1.2",
    "jszip": "^3.10.1",
    "jszip-utils": "^0.1.0",
    "libheif-js": "^1.19.8",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "redux-persist": "^6.0.0",
    "styled-components": "^6.5.1",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/utif": "^3.0.6",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "only-allow": "^1.2.2",
    "prettier": "^3.9.6",
    "react-metrika": "^0.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.3",
    "vite-bundle-analyzer": "^0.20.2"
  },
  "overrides": {
    "eslint": "9.27.0"
  }
}
